{
  "name": "dsh-wsl",
  "version": "0.1.0",
  "private": true,
  "description": "WSL execution for DeepSeek Harness on Windows: ships the minimal-wsl agent preset (bash executes inside WSL via wsl.exe, non-persistent + persistent PTY), a general-purpose wsl model tool for standard/cordis presets, and a Web Plugins settings tab with distro diagnostics over the /wsl-manager JSON API.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-agent-presets": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-cordis-host-runner": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-terminal": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "license": "MIT"
}
